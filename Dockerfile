# 1. Используем легковесный образ Python 2.7 (под который написан исходный проект)
FROM python:2.7-slim

# 2. Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# 3. Копируем файл зависимостей и устанавливаем библиотеки
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. Копируем весь остальной код проекта в контейнер
COPY . .

# 5. Открываем порт, на котором работает приложение
EXPOSE 7345

# 6. Запускаем Flask-приложение
CMD ["python", "manage.py", "runserver", "-h", "0.0.0.0", "-p", "7345"]
